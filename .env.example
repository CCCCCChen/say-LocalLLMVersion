# Say 应用环境配置文件
# 复制此文件为 .env 并根据需要修改配置

# =============================================================================
# FunASR Docker Service Configuration
# FunASR Docker 部署服务配置
# =============================================================================

# 基础服务配置
# 注意：在 Vite 项目中，环境变量需要 VITE_ 前缀才能在浏览器中访问
VITE_FUNASR_ENABLED=false
FUNASR_ENABLED=false
VITE_FUNASR_HOST=localhost
FUNASR_HOST=localhost
VITE_FUNASR_PORT=10095
FUNASR_PORT=10095
VITE_FUNASR_SSL=false
FUNASR_SSL=false

# 服务模式配置
# 可选值: 
# - offline: 离线文件转录 (推荐，准确率高)
# - online: 实时语音识别 (低延迟)
# - 2pass: 实时+离线纠错 (平衡模式)
VITE_FUNASR_MODE=offline
FUNASR_MODE=offline

# 认证配置 (如果FunASR服务需要认证)
VITE_FUNASR_USERNAME=
FUNASR_USERNAME=
VITE_FUNASR_PASSWORD=
FUNASR_PASSWORD=
VITE_FUNASR_API_KEY=
FUNASR_API_KEY=
VITE_FUNASR_TOKEN=
FUNASR_TOKEN=

# 热词配置 (提高特定词汇识别准确率)
VITE_FUNASR_HOTWORDS=
FUNASR_HOTWORDS=
# 示例: FUNASR_HOTWORDS=人工智能,机器学习,深度学习
# 或使用文件: 将热词放在 hotwords.txt 文件中，每行一个

# 高级配置
VITE_FUNASR_ITN_ENABLED=true          # 逆文本标准化 (数字、时间等格式化)
FUNASR_ITN_ENABLED=true          # 逆文本标准化 (数字、时间等格式化)
VITE_FUNASR_VAD_ENABLED=true          # 语音活动检测
FUNASR_VAD_ENABLED=true          # 语音活动检测
VITE_FUNASR_PUNC_ENABLED=true         # 标点符号预测
FUNASR_PUNC_ENABLED=true         # 标点符号预测
VITE_FUNASR_USE_TIMESTAMP=true        # 时间戳信息
FUNASR_USE_TIMESTAMP=true        # 时间戳信息

# 性能配置
VITE_FUNASR_MAX_CONCURRENT=10         # 最大并发连接数
FUNASR_MAX_CONCURRENT=10         # 最大并发连接数
VITE_FUNASR_TIMEOUT=30000             # 超时时间 (毫秒)
FUNASR_TIMEOUT=30000             # 超时时间 (毫秒)
VITE_FUNASR_CHUNK_SIZE=5120           # 音频块大小
FUNASR_CHUNK_SIZE=5120           # 音频块大小
VITE_FUNASR_CHUNK_INTERVAL=10         # 发送间隔 (毫秒)
FUNASR_CHUNK_INTERVAL=10         # 发送间隔 (毫秒)

# 音频配置
FUNASR_SAMPLE_RATE=16000         # 采样率
FUNASR_AUDIO_FORMAT=wav          # 音频格式

# 回退配置
FUNASR_FALLBACK_TO_WHISPER=true # 当FunASR不可用时回退到Whisper
FUNASR_AUTO_RETRY=true           # 自动重试
FUNASR_RETRY_COUNT=3             # 重试次数
FUNASR_RETRY_DELAY=1000          # 重试延迟 (毫秒)

# =============================================================================
# Docker 部署配置
# =============================================================================

# Docker 快速启动命令:
# docker-compose -f docker-compose.funasr.yml up -d
#
# 或手动启动:
# docker run -p 10095:10095 -it --rm \
#   registry.cn-hangzhou.aliyuncs.com/funasr_repo/funasr:funasr-runtime-sdk-online-cpu-0.1.10

# =============================================================================
# Whisper 配置 (备用转录服务)
# =============================================================================

# Whisper 模型配置
WHISPER_MODEL=whisper-base       # 默认模型
WHISPER_QUANTIZED=true           # 使用量化模型
WHISPER_MULTILINGUAL=true        # 多语言支持
WHISPER_LANGUAGE=auto            # 自动检测语言
WHISPER_TASK=transcribe          # 任务类型: transcribe 或 translate

# =============================================================================
# 应用配置
# =============================================================================

# 开发环境配置
NODE_ENV=development
DEV_MODE=true
LOG_LEVEL=info

# 调试配置
DEBUG_TRANSCRIPTION=false        # 转录调试模式
DEBUG_NETWORK=false              # 网络调试模式
DEBUG_PERFORMANCE=false          # 性能调试模式

# 缓存配置
ENABLE_MODEL_CACHE=true          # 启用模型缓存
CACHE_DIR=./cache                # 缓存目录
MAX_CACHE_SIZE=1000              # 最大缓存大小 (MB)

# =============================================================================
# 网络配置
# =============================================================================

# 代理配置 (如果需要)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# 镜像配置
USE_CHINA_MIRROR=false           # 使用国内镜像
CUSTOM_MIRROR_URL=               # 自定义镜像地址

# =============================================================================
# 安全配置
# =============================================================================

# CORS 配置
CORS_ORIGIN=*                    # 允许的源
CORS_METHODS=GET,POST,PUT,DELETE # 允许的方法

# 速率限制
RATE_LIMIT_ENABLED=false         # 启用速率限制
RATE_LIMIT_MAX=100               # 每分钟最大请求数

# =============================================================================
# 监控和日志
# =============================================================================

# 日志配置
LOG_FORMAT=json                  # 日志格式: json 或 text
LOG_FILE=./logs/app.log          # 日志文件路径
LOG_MAX_SIZE=10                  # 日志文件最大大小 (MB)
LOG_MAX_FILES=5                  # 保留的日志文件数量

# 监控配置
ENABLE_METRICS=false             # 启用指标收集
METRICS_PORT=9090                # 指标端口

# 健康检查
HEALTH_CHECK_ENABLED=true        # 启用健康检查
HEALTH_CHECK_INTERVAL=30         # 检查间隔 (秒)

# =============================================================================
# 实验性功能
# =============================================================================

# AI 功能
ENABLE_AI_SUMMARY=false          # 启用AI摘要
ENABLE_AI_TRANSLATION=false      # 启用AI翻译
ENABLE_SENTIMENT_ANALYSIS=false  # 启用情感分析

# 高级转录功能
ENABLE_SPEAKER_DIARIZATION=false # 启用说话人分离
ENABLE_NOISE_REDUCTION=false     # 启用降噪
ENABLE_ECHO_CANCELLATION=false   # 启用回声消除

# =============================================================================
# 注意事项
# =============================================================================

# 1. 首次使用请先启动 FunASR Docker 服务
# 2. 确保防火墙允许相应端口访问
# 3. 生产环境请修改默认密码和密钥
# 4. 定期更新 Docker 镜像以获得最新功能
# 5. 监控服务资源使用情况，适当调整配置