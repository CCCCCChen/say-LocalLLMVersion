# Dify Workflow Configuration
# Copy this file to .env.local and fill in your actual values

# Your Dify API key (required)
# Get this from your Dify dashboard: https://dify.ai/
VITE_DIFY_API_KEY=your_dify_api_key_here

# Dify API base URL (optional, defaults to official API)
# For self-hosted instances, change this to your instance URL
VITE_DIFY_BASE_URL=https://api.dify.ai/v1

# Workflow ID (optional)
# If you have a specific workflow ID, you can set it here
VITE_DIFY_WORKFLOW_ID=your_workflow_id_here

# Example for self-hosted Dify:
# VITE_DIFY_BASE_URL=https://your-dify-instance.com/v1